# dashboard – Vite 环境变量
# Copy this file to .env.local and fill in values.

# Backend API proxy target (dev only)
VITE_API_PROXY_TARGET=http://localhost:6066

# --- Paddle Billing ---
# Paddle 客户端 Token（在 Paddle 后台 Developer > Authentication 获取，用于 Paddle.js）
# 注意：这是客户端 token (pdl_xxx)，不是 API Key (sk_xxx)
VITE_PADDLE_CLIENT_TOKEN=pdl_placeholder_client_token

# Paddle 环境：sandbox 或 production
VITE_PADDLE_ENV=sandbox

# 基础版 (Pro) 月付价格 ID
VITE_PADDLE_PRICE_PRO_MONTHLY=pri_placeholder_pro_monthly
# 基础版 (Pro) 年付价格 ID
VITE_PADDLE_PRICE_PRO_YEARLY=pri_placeholder_pro_yearly
# 无限版 (Unlimited) 月付价格 ID
VITE_PADDLE_PRICE_UNLIMITED_MONTHLY=pri_placeholder_unlimited_monthly
# 无限版 (Unlimited) 年付价格 ID
VITE_PADDLE_PRICE_UNLIMITED_YEARLY=pri_placeholder_unlimited_yearly

# dashboard – 本地开发环境变量（仅本地 Vite dev server 使用）
# 生产/Docker 部署时所有变量均从根目录 .env 统一读取，无需单独配置此文件。
# Copy this file to .env.local for local development without Docker.

# Backend API proxy target (Vite dev server only, not exposed to frontend code)
VITE_API_PROXY_TARGET=http://localhost:6066

# --- Paddle Billing ---
# 以下变量在 Docker 部署时自动从根目录 .env 传入，key 名称完全相同（无 VITE_ 前缀）

# Paddle 环境：sandbox 或 production
PADDLE_ENV=sandbox

# Paddle 客户端 Token（在 Paddle 后台 Developer > Authentication 获取，用于 Paddle.js）
# 注意：这是客户端 token (pdl_xxx)，不是 API Key (sk_xxx)
PADDLE_CLIENT_TOKEN=pdl_placeholder_client_token

# 基础版 (Pro) 月付价格 ID
PADDLE_PRICE_PRO_MONTHLY=pri_placeholder_pro_monthly
# 基础版 (Pro) 年付价格 ID
PADDLE_PRICE_PRO_YEARLY=pri_placeholder_pro_yearly
# 无限版 (Unlimited) 月付价格 ID
PADDLE_PRICE_UNLIMITED_MONTHLY=pri_placeholder_unlimited_monthly
# 无限版 (Unlimited) 年付价格 ID
PADDLE_PRICE_UNLIMITED_YEARLY=pri_placeholder_unlimited_yearly

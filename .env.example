# share-installs - Environment Variables Template
# Copy this file to .env and fill in the values

# --- Domain & Traefik ---
DASHBOARD_DOMAIN=console.share-installs.local
ACME_EMAIL=your-email@example.com

# --- Ports (Dev Only) ---
BACKEND_PORT=6066
DB_PORT=5432
REDIS_PORT=6379

# --- Backend Config ---
# Multi-tenant mode (true/false)
MULTI_TENANT=false
# comma-separated list of allowed origins
CORS_ORIGINS=*
# API Admin Secret (for high-privilege operations)
ADMIN_SECRET=changeme_in_production
# Log Level: error, warn, info, debug, trace
LOG_LEVEL=debug

# --- Security & Auth ---
# JWT Secret for session tokens
JWT_SECRET=generate_a_random_string
# Encryption key for API Keys (must be 32 bytes/char for AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars

# --- OAuth (GitHub) ---
# Register at: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# --- Fingerprinting ---
FINGERPRINT_MATCH_THRESHOLD=0.75
FINGERPRINT_MATCH_TTL_HOURS=72

# --- Paddle Billing ---
# Paddle Environment (sandbox/production)
PADDLE_ENV=sandbox
# Paddle Client Token (Developer > Authentication > Client-side Token, pdl_...)
PADDLE_CLIENT_TOKEN=your_client_token
# Paddle API Key（在 Paddle 后台 Developer > Authentication 获取 Secret Key, sk_...)
PADDLE_API_KEY=your_paddle_api_key
# Paddle Webhook 签名密钥（在 Paddle 后台 Notifications > Webhooks 获取, whsec_...)
PADDLE_WEBHOOK_SECRET=your_webhook_secret
# 基础版 (Pro) 月付价格 ID
PADDLE_PRICE_PRO_MONTHLY=pri_placeholder_pro_monthly
# 基础版 (Pro) 年付价格 ID
PADDLE_PRICE_PRO_YEARLY=pri_placeholder_pro_yearly
# 无限版 (Unlimited) 月付价格 ID
PADDLE_PRICE_UNLIMITED_MONTHLY=pri_placeholder_unlimited_monthly
# 无限版 (Unlimited) 年付价格 ID
PADDLE_PRICE_UNLIMITED_YEARLY=pri_placeholder_unlimited_yearly
